export struct AppItem {
    name: string,
    path: string,
    command: string,
    icon: image,
    pinned: bool,
}

export struct FileItem {
    name: string,
    path: string,
    is-dir: bool,
    // icon kind, see files_search::file_kind in Rust
    kind: int,
    // image thumbnail filled in by a background worker; empty = show the icon
    thumb: image,
    // 0 = matched by name (default, no badge), 1 = semantic (CLIP),
    // 2 = by the text on the image (OCR)
    match-kind: int,
    // match strength in 0-100 percent, only for match-kind 1 and 2
    match-score: int,
}

// One row of the Agents section in the settings menu, see ui/settings.rs
export struct AgentRow {
    name: string,
    status: string,
    // button label ("Connect" / "Disconnect"); "" = no button
    action: string,
}

// One settings.json key in the settings menu, see ui/settings.rs
export struct SettingField {
    key: string,
    // 0 = bool, 1 = "#RRGGBB" color, 2 = other string, 3 = list of strings
    kind: int,
    text: string,
    // swatch for kind 1 (Slint can't parse "#RRGGBB" itself)
    color: color,
    on: bool,
    items: [string],
    // set on the first row of a menu section only
    heading: string,
}
