import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AgentRow, SettingField, SettingsPage, ThemeOption } from "../types.slint";

// Text field that commits on Enter and on focus loss. After a commit it shows
// `value` again: the new one when Rust accepted the edit, the old one when not.
component SettingInput inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    callback commit(string);

    height: 28px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    function submit() {
        if input.text != root.value {
            root.commit(input.text);
            input.text = root.value;
        }
    }
    // typing breaks the text binding, so model updates are pushed by hand
    changed value => { input.text = root.value; }

    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.value;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.submit(); }
        changed has-focus => {
            if !self.has-focus { root.submit(); }
        }
    }

    if input.text == "": Text {
        x: 8px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-dim;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// Small bordered text button (Restart, "−").
component SettingButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    width: max(28px, label-text.preferred-width + 20px);
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: keys.has-focus ? Theme.accent : Theme.border;

    label-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: Theme.accent;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
    keys := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component ThemePreview inherits Rectangle {
    in property <ThemeOption> palette;

    border-radius: 5px;
    border-width: 1px;
    border-color: root.palette.border;
    background: root.palette.bg;
    accessible-role: none;

    VerticalLayout {
        padding: 5px;
        spacing: 3px;

        Rectangle {
            height: 9px;
            border-radius: 2px;
            background: root.palette.surface;

            Rectangle {
                x: 4px;
                y: 3px;
                width: 22px;
                height: 3px;
                border-radius: 1px;
                background: root.palette.text-dim;
            }
        }
        Rectangle {
            height: 10px;
            border-radius: 2px;
            background: root.palette.selected;

            Rectangle {
                x: 4px;
                y: 3px;
                width: 4px;
                height: 4px;
                border-radius: 1px;
                background: root.palette.accent;
            }
            Rectangle {
                x: 12px;
                y: 3px;
                width: 34px;
                height: 4px;
                border-radius: 1px;
                background: root.palette.text;
            }
        }
    }
}

component ThemePicker inherits Rectangle {
    in property <[ThemeOption]> themes;
    in property <int> active-theme;
    callback select(string);
    callback back();

    private property <int> cursor;
    private property <int> columns: 4;
    private property <length> card-height: 64px;
    private property <length> gap: 7px;

    init => {
        root.cursor = root.active-theme;
        keys.focus();
    }

    function reveal-cursor() {
        let top = floor(root.cursor / root.columns) * (root.card-height + root.gap);
        let bottom = top + root.card-height;
        if top < -cards.content-y {
            cards.content-y = -top;
        } else if bottom > cards.visible-height - cards.content-y {
            cards.content-y = cards.visible-height - bottom;
        }
    }

    keys := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if root.themes.length == 0 {
                return reject;
            }
            if event.text == Key.Return || event.text == Key.Space {
                root.select(root.themes[root.cursor].id);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow {
                let step = event.text == Key.LeftArrow ? -1 : event.text == Key.RightArrow ? 1
                    : event.text == Key.UpArrow ? -root.columns : root.columns;
                root.cursor = clamp(root.cursor + step, 0, root.themes.length - 1);
                root.reveal-cursor();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: root.gap;

        HorizontalLayout {
            Text {
                text: "Choose theme";
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            SettingButton {
                label: "Back";
                clicked => { root.back(); }
            }
        }

        cards := ScrollView {
            horizontal-scrollbar-policy: always-off;
            changed visible-height => { root.reveal-cursor(); }

            VerticalLayout {
                padding-right: 14px;
                spacing: root.gap;
                alignment: start;

                for row in ceil(root.themes.length / root.columns): HorizontalLayout {
                    spacing: root.gap;
                    alignment: start;

                    for col in min(root.columns, root.themes.length - row * root.columns): Rectangle {
                        private property <int> index: row * root.columns + col;
                        private property <ThemeOption> option: root.themes[self.index];
                        private property <bool> active: index == root.active-theme;
                        private property <bool> focused: keys.has-focus && index == root.cursor;

                        width: (cards.visible-width - 14px - (root.columns - 1) * root.gap) / root.columns;
                        height: root.card-height;
                        border-radius: 7px;
                        border-width: focused ? 2px : 1px;
                        border-color: active || focused ? Theme.accent : Theme.border;
                        background: touch.has-hover || focused ? Theme.hover : Theme.surface;
                        accessible-role: button;
                        accessible-label: option.name;
                        accessible-checkable: true;
                        accessible-checked: active;
                        accessible-action-default => { touch.clicked(); }

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;

                            ThemePreview {
                                palette: option;
                                height: 32px;
                            }
                            HorizontalLayout {
                                spacing: 3px;
                                Text {
                                    text: option.name;
                                    color: Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if active: Text {
                                    text: "✓";
                                    color: Theme.accent;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        touch := TouchArea {
                            clicked => {
                                root.cursor = index;
                                keys.focus();
                                root.select(option.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// mode 5: settings.json keys as rows; the file is the only state, Rust
// rebuilds `settings` from it after every change.
export component SettingsView {
    in-out property <SettingsPage> page;
    in property <[SettingField]> settings;
    in property <[ThemeOption]> themes;
    in property <int> active-theme;
    in property <[SettingField]> custom-colors;
    in property <string> settings-error;
    in property <bool> needs-restart;
    in property <[AgentRow]> agents;
    in property <bool> agents-idle;
    callback back();
    callback select-theme(string) -> bool;
    callback agent-toggle(int);
    callback setting-toggle(string);
    callback setting-text(string, string);
    callback setting-list-set(string, int, string);
    callback setting-list-add(string, string);
    callback setting-list-remove(string, int);
    callback restart();

    // fills the fixed results area, minus a calc result or progress bars
    vertical-stretch: 1;

    VerticalLayout {
        spacing: 8px;

        if root.settings-error != "": Text {
            text: root.settings-error;
            color: Theme.accent;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.page == SettingsPage.overview && root.needs-restart: HorizontalLayout {
            spacing: 10px;

            Text {
                horizontal-stretch: 1;
                text: "search_dirs / semantic / ocr / docs apply after a restart";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            SettingButton {
                label: "Restart";
                clicked => { root.restart(); }
            }
        }

        if root.page == SettingsPage.overview: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-right: 12px;
                spacing: 6px;

                if root.themes.length > 0: VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "Appearance";
                        color: Theme.text-dim;
                        font-size: 12px;
                        height: 18px;
                    }
                    HorizontalLayout {
                        spacing: 10px;

                        ThemePreview {
                            width: 76px;
                            height: 32px;
                            palette: root.themes[root.active-theme];
                        }
                        Text {
                            text: root.themes[root.active-theme].name;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        SettingButton {
                            label: "Change theme";
                            clicked => { root.page = SettingsPage.themes; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: "Agents";
                            color: Theme.text-dim;
                            font-size: 12px;
                            height: 18px;
                        }
                        if root.agents-idle: Text {
                            horizontal-stretch: 1;
                            text: "won't work while semantic and ocr are off";
                            color: Theme.text-dim;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    for agent[i] in root.agents: HorizontalLayout {
                        spacing: 10px;

                        Text {
                            width: 130px;
                            height: 28px;
                            text: agent.name;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: agent.status;
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if agent.action != "": SettingButton {
                            label: agent.action;
                            clicked => { root.agent-toggle(i); }
                        }
                    }
                }

                for field in root.settings: VerticalLayout {
                    spacing: 6px;

                    if field.heading != "": Text {
                        text: field.heading;
                        color: Theme.text-dim;
                        font-size: 12px;
                        height: 18px;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            width: 130px;
                            height: 28px;
                            text: field.label;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if field.kind == 0: HorizontalLayout {
                            alignment: start;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            Rectangle {
                                width: 36px;
                                height: 20px;
                                border-radius: 10px;
                                background: field.on ? Theme.accent : Theme.selected;
                                border-width: 1px;
                                border-color: field.on ? Theme.accent : Theme.border;

                                Rectangle {
                                    x: field.on ? parent.width - self.width - 3px : 3px;
                                    y: 3px;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: field.on ? Theme.bg : Theme.text-dim;
                                }
                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => { root.setting-toggle(field.key); }
                                }
                            }
                        }

                        if field.kind == 1 || field.kind == 2: HorizontalLayout {
                            spacing: 8px;

                            if field.kind == 1: Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: field.color;
                                border-width: 1px;
                                border-color: Theme.border;
                            }
                            SettingInput {
                                value: field.text;
                                commit(text) => { root.setting-text(field.key, text); }
                            }
                        }

                        if field.kind == 3: VerticalLayout {
                            spacing: 6px;

                            for item[i] in field.items: HorizontalLayout {
                                spacing: 8px;

                                SettingInput {
                                    value: item;
                                    commit(text) => { root.setting-list-set(field.key, i, text); }
                                }
                                SettingButton {
                                    label: "−";
                                    clicked => { root.setting-list-remove(field.key, i); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;

                                SettingInput {
                                    placeholder: "+ add";
                                    commit(text) => { root.setting-list-add(field.key, text); }
                                }
                                // keeps the add field as wide as the item fields
                                Rectangle { width: 28px; }
                            }
                        }
                    }
                }
            }
        }
        if root.page == SettingsPage.themes: ThemePicker {
            themes: root.themes;
            active-theme: root.active-theme;
            back => { root.back(); }
            select(id) => {
                if root.select-theme(id) && id == "custom" {
                    root.page = SettingsPage.custom;
                }
            }
        }
        if root.page == SettingsPage.custom: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: "Custom theme";
                    color: Theme.text;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                back-button := SettingButton {
                    label: "Back";
                    init => { self.focus(); }
                    clicked => { root.back(); }
                }
            }
            ScrollView {
                VerticalLayout {
                    padding-right: 14px;
                    spacing: 6px;
                    for field in root.custom-colors: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 130px;
                            height: 28px;
                            text: field.label;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: field.color;
                            border-width: 1px;
                            border-color: Theme.border;
                        }
                        SettingInput {
                            value: field.text;
                            commit(text) => { root.setting-text(field.key, text); }
                        }
                    }
                }
            }
        }
    }
}
