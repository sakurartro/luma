// Palette; main.rs overrides it from settings.json.
export global Theme {
    in-out property <color> bg: #0E120B;
    in-out property <color> surface: #151B10;
    in-out property <color> hover: #1E2716;
    in-out property <color> selected: #28331C;
    in-out property <color> border: #2C3620;
    in-out property <color> accent: #A9B665;
    in-out property <color> text: #E4E7D0;
    in-out property <color> text-dim: #7E8A6C;
}
