import { ScrollView } from "std-widgets.slint";

export struct AppItem {
    name: string,
    path: string,
    command: string,
    icon: image,
}

export component MainWindow inherits Window {
    in property <[AppItem]> apps;
    in property <[string]> categories;
    in-out property <string> selected-category;
    callback show_apps();
    callback launch_app(AppItem);
    callback search_apps(query: string);
    callback filter_category(string);
    callback run_query(string);
    callback hide-window();

    public function focus-input() {
        search-input.focus();
    }
    public function reset-view() {
        root.apps-open = false;
        root.selected-category = "";
    }
    in-out property <string> query-result;
    in-out property <string> input-text;
    private property <bool> apps-open: false;

    width: 760px;
    height: 420px;
    background: transparent;

    FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.hide-window(); }
        }

        KeyBinding {
            keys: @keys(Alt + "1");
            activated => {
                root.apps-open = !root.apps-open;
                if root.apps-open {
                    root.show_apps();
                    if root.input-text != "" {
                        root.search_apps(root.input-text);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 10px;

        HorizontalLayout {
            height: 60px;
            spacing: 10px;

            Rectangle {
                horizontal-stretch: 1;
                height: 60px;
                border-radius: 30px;
                background: #1C1E23;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;

                    Image {
                        source: @image-url("assets/search.svg");
                        colorize: #8B9CFF;
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2 - 1px;
                    }

                    search-input := TextInput {
                        text <=> root.input-text;
                        font-size: 20px;
                        color: #F3F4F6;
                        vertical-alignment: center;
                        key-pressed(event) => {
                            if event.modifiers.alt && event.text == "1" {
                                root.apps-open = !root.apps-open;
                                if root.apps-open {
                                    root.show_apps();
                                    if root.input-text != "" {
                                        root.search_apps(root.input-text);
                                    }
                                }
                                return accept;
                            }
                            return reject;
                        }
                        edited => {
                            if root.apps-open {
                                root.search_apps(self.text);
                            }
                        }
                        accepted => {
                            if root.apps-open && root.apps.length > 0 {
                                root.launch-app(root.apps[0]);
                            } else {
                                root.run_query(self.text);
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: root.apps-open ? #343A50 : #25282F;

                Image {
                    source: @image-url("assets/layout-grid.svg");
                    colorize: #B8BEC9;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.apps-open = !root.apps-open;

                        if root.apps-open {
                            root.show_apps();
                            if root.input-text != "" {
                                root.search_apps(root.input-text);
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: #25282F;

                Image {
                    source: @image-url("assets/folder.svg");
                    colorize: #B8BEC9;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: #25282F;

                Image {
                    source: @image-url("assets/zap.svg");
                    colorize: #B8BEC9;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: #25282F;

                Image {
                    source: @image-url("assets/clipboard-pen.svg");
                    colorize: #B8BEC9;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        if root.query-result != "": Rectangle {
            height: 48px;
            background: #1C1E23;
            border-radius: 16px;

            Text {
                text: root.query-result;
                color: #8B9CFF;
                font-size: 16px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        if root.apps-open: Rectangle{
            height: 350px;
            background: #1C1E23;
            border-radius: 22px;

            VerticalLayout {

            Flickable {
                height: 40px;
                content-width: pills-row.preferred-width;

                pills-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                spacing: 8px;
                alignment: start;

                for cat in root.categories: Rectangle {
                    height: 28px;
                    min-width: cat-text.preferred-width + 24px;
                    horizontal-stretch: 0;
                    border-radius: 14px;
                    background: root.selected-category == cat ? #343A50 : #25282F;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        cat-text := Text {
                            text: cat;
                            font-size: 13px;
                            vertical-alignment: center;
                            color: root.selected-category == cat ? #F3F4F6 : #B8BEC9;
                            overflow: elide;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.selected-category = root.selected-category == cat ? "" : cat;
                            root.filter_category(root.selected-category);
                        }
                    }
                }
                }
            }

            ScrollView {
                width: parent.width;
                height: parent.height;

                FlexboxLayout {
                    padding: 16px;
                    spacing: 12px;

                    flex-direction: row;
                    flex-wrap: wrap;

                    for app in root.apps: Rectangle {
                        width: 90px;
                        height: 90px;

                        border-radius: 12px;

                        background: app-touch.has-hover
                            ? #2A2E38
                            : transparent;

                        place := Rectangle {
                            width: 50px;
                            height: 50px;

                            x: (parent.width - self.width) / 2;
                            y: 6px;
                            background: #343A50;
                        }

                        Text {
                            text: app.name;

                            x: 4px;
                            y: 62px;

                            width: parent.width - 8px;
                            height: 20px;
                            color: #F3F4F6;
                            font-size: 12px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Image {
                            source: app.icon;

                            x: place.x;
                            y: place.y;

                            width: 50px;
                            height: 50px;

                            image-fit: contain;
                        }

                        app-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;

                            clicked => {
                                root.launch-app(app);
                            }
                        }

                    }

                }
            }
            }
        }

        }
    }
}

export component LoadingWindow inherits Window {
    width: 240px;
    height: 52px;
    background: transparent;

    Rectangle {
        border-radius: 26px;
        background: #1C1E23;

        Text {
            text: "Loading...";
            color: #F3F4F6;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}
