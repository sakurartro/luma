import { Theme } from "theme.slint";
import { AppItem, FileItem } from "types.slint";
import { ModeButton, ProgressBar } from "widgets.slint";
import { AppsView } from "views/apps.slint";
import { FilesView } from "views/files.slint";
import { PowerView } from "views/power.slint";
import { MixedView } from "views/mixed.slint";

export { Theme, AppItem, FileItem }

// Omarchy/Walker-ish restyle of the Spotlight layout.

export component MainWindow inherits Window {
    in property <[AppItem]> apps;
    in property <[FileItem]> files;
    in property <[string]> categories;
    in-out property <string> selected-category;
    // 0 = closed, 1 = apps, 2 = files, 3 = power, 4 = photos (files tab, images only)
    in-out property <int> mode: 0;
    // files tab sort: 0 = name, 1 = newest, 2 = oldest
    in-out property <int> files-sort: 0;
    callback show_apps();
    callback show_files();
    callback show_power_modes();
    callback launch_app(AppItem);
    callback toggle-pin(AppItem);
    callback open_file(FileItem);
    callback search_apps(query: string);
    callback search_files(query: string);
    callback search_all(query: string);
    callback filter_category(string);
    callback run_query(string);
    callback power-action(string);
    callback hide-window();

    // keyboard selection; in mode 0 it runs through apps first, then files
    in-out property <int> sel: 0;
    // columns of the apps/files grid, pushed from the grid itself
    property <int> cols: 1;
    property <int> sel-len: root.mode == 0 ? root.apps.length + root.files.length
        : root.mode == 1 ? root.apps.length
        : root.mode == 2 || root.mode == 4 ? root.files.length
        : root.power-opts.length;
    property <[{ action: string, icon: image }]> power-opts: [
        { action: "poweroff", icon: @image-url("assets/power.svg") },
        { action: "reboot",   icon: @image-url("assets/rotate-cw.svg") },
        { action: "suspend",  icon: @image-url("assets/moon.svg") },
        { action: "lock",     icon: @image-url("assets/lock.svg") },
    ];

    // Full-name plate for a hovered item whose name is elided. It belongs to
    // item tip-sel and shows only while that item is selected, so arrow keys hide it.
    property <string> tip-text;
    property <int> tip-sel: -1;
    property <length> tip-x;
    property <length> tip-y;
    property <length> tip-h;
    changed mode => { root.tip-sel = -1; }
    changed apps => { root.tip-sel = -1; }
    changed files => { root.tip-sel = -1; }

    // name is "" when the item's label fits; leaving an item only clears its own
    // plate, since the next item's hover may arrive first
    function hover-tip(hover: bool, idx: int, name: string, x: length, y: length, h: length) {
        if hover {
            root.tip-sel = idx;
            root.tip-text = name;
            root.tip-x = x;
            root.tip-y = y;
            root.tip-h = h;
        } else if root.tip-sel == idx {
            root.tip-sel = -1;
        }
    }

    // also clamps, since the models can shrink when async results arrive
    function move-sel(d: int) {
        root.sel = max(0, min(root.sel-len - 1, root.sel + d));
    }

    function activate-mode(m: int) {
        // power mode starts with nothing selected: a stray Enter must not power off
        root.sel = m == 3 && root.mode != 3 ? -1 : 0;
        if root.mode == m {
            root.mode = 0;
        } else {
            root.mode = m;
            if m == 1 {
                root.show_apps();
            }
            if m == 2 || m == 4 {
                root.show_files();
            }
            if root.input-text != "" {
                if m == 1 { root.search_apps(root.input-text); }
                if m == 2 || m == 4 { root.search_files(root.input-text); }
            }
            if m == 3 {
                root.show_power_modes()
            }
        }
    }

    public function focus-input() {
        search-input.focus();
    }
    // Re-run the current files view; main.rs calls it when a background
    // files reload has finished.
    public function refresh-view() {
        if root.mode == 0 && root.input-text != "" {
            root.search_all(root.input-text);
        }
        if root.mode == 2 || root.mode == 4 {
            if root.input-text != "" {
                root.search_files(root.input-text);
            } else {
                root.show_files();
            }
        }
    }
    public function reset-view() {
        root.mode = 0;
        root.sel = 0;
        root.selected-category = "";
        root.tip-sel = -1;
    }
    in-out property <string> query-result;
    in-out property <string> input-text;
    in-out property <bool> indexing: false;
    in-out property <int> index-percent: 0;
    in-out property <bool> clip-busy: false;
    in-out property <int> clip-percent: 0;
    in-out property <string> clip-label;
    // false when both `semantic` and `ocr` are off: photos match by name only
    in property <bool> content-search: true;

    min-width: 760px;
    max-width: 760px;
    background: transparent;
    default-font-family: "JetBrainsMono Nerd Font";

    FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.hide-window(); }
        }

        KeyBinding {
            keys: @keys(Alt + "1");
            activated => { root.activate-mode(1); }
        }

        KeyBinding {
            keys: @keys(Alt + "2");
            activated => { root.activate-mode(2); }
        }

        KeyBinding {
            keys: @keys(Alt + "3");
            activated => { root.activate-mode(4); }
        }

        KeyBinding {
            keys: @keys(Alt + "4");
            activated => { root.activate-mode(5); }
        }

        KeyBinding {
            keys: @keys(Control + ",");
            activated => { root.activate-mode(5); }
        }

        // Single bordered panel instead of floating pills
        Rectangle {
            background: Theme.bg;
            border-width: 2px;
            border-color: Theme.border;
            border-radius: 10px;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

            HorizontalLayout {
                height: 52px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 52px;
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        Image {
                            source: @image-url("assets/search.svg");
                            colorize: Theme.accent;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }

                        search-input := TextInput {
                            text <=> root.input-text;
                            font-size: 17px;
                            color: Theme.text;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if event.modifiers.alt && event.text == "1" {
                                    root.activate-mode(1);
                                    return accept;
                                }
                                if event.modifiers.alt && event.text == "2" {
                                    root.activate-mode(2);
                                    return accept;
                                }
                                if event.modifiers.alt && event.text == "3" {
                                    root.activate-mode(4);
                                    return accept;
                                }
                                if (event.modifiers.alt && event.text == "4") || (event.modifiers.control && event.text == ",") {
                                    root.activate-mode(5);
                                    return accept;
                                }
                                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                                    root.move-sel((event.text == Key.DownArrow ? 1 : -1) * (root.mode == 1 || root.mode == 2 || root.mode == 4 ? root.cols : 1));
                                    return accept;
                                }
                                // in mode 0 Left/Right keep moving the text cursor
                                if root.mode != 0 && (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
                                    root.move-sel(event.text == Key.RightArrow ? 1 : -1);
                                    return accept;
                                }
                                return reject;
                            }
                            edited => {
                                root.sel = root.mode == 3 ? -1 : 0;
                                if root.mode == 0 && self.text != "" {
                                    root.search_all(self.text);
                                }
                                if root.mode == 1 {
                                    root.search_apps(self.text);
                                }
                                if root.mode == 2 || root.mode == 4 {
                                    root.search_files(self.text);
                                }
                                // live calc/currency result; clears it when the text stops matching
                                root.run_query(self.text);
                            }
                            accepted => {
                                // a calc/currency result is shown: Enter must not open the fuzzy hit under it
                                if root.mode != 3 && root.query-result != "" {
                                    return;
                                }
                                // sel stays -1 in power mode until an arrow picks a button
                                if root.mode != 3 {
                                    root.move-sel(0);
                                }
                                if root.mode == 0 {
                                    if self.text == "" {
                                        return;
                                    }
                                    if root.sel < root.apps.length {
                                        root.launch-app(root.apps[root.sel]);
                                        root.hide-window();
                                    } else if root.files.length > 0 {
                                        root.open-file(root.files[root.sel - root.apps.length]);
                                        root.hide-window();
                                    }
                                } else if root.mode == 1 && root.apps.length > 0 {
                                    root.launch-app(root.apps[root.sel]);
                                    root.hide-window();
                                } else if (root.mode == 2 || root.mode == 4) && root.files.length > 0 {
                                    root.open-file(root.files[root.sel]);
                                    root.hide-window();
                                } else if root.mode == 3 && root.sel >= 0 {
                                    root.power-action(root.power-opts[root.sel].action);
                                }
                            }
                        }

if root.input-text == "": Text {
                        text: root.mode == 1 ? "Search apps..." : root.mode == 2 ? "Search files..." : root.mode == 4 ? "Search photos..." : root.mode == 5 ? "Settings" : "Search...";
                        color: Theme.text-dim;
                        font-size: 17px;
                        vertical-alignment: center;
                    }
                    }
                }

                ModeButton {
                    icon: @image-url("assets/layout-grid.svg");
                    active: root.mode == 1;
                    clicked => {
                        root.activate-mode(1);
                    }
                }

                ModeButton {
                    icon: @image-url("assets/folder.svg");
                    active: root.mode == 2;
                    clicked => {
                        root.activate-mode(2);
                    }
                }

                ModeButton {
                    icon: @image-url("assets/image.svg");
                    active: root.mode == 4;
                    clicked => {
                        root.activate-mode(4);
                    }
                }

                ModeButton {
                    icon: @image-url("assets/settings.svg");
                    active: root.mode == 5;
                    clicked => {
                        root.activate-mode(5);
                    }
                }
            }

            if root.query-result != "": Rectangle {
                height: 44px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: root.query-result;
                    color: Theme.accent;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.indexing: ProgressBar {
                label: "Indexing files...";
                percent: root.index-percent;
            }

            // Model download / photo indexing, same progress-bar style.
            if root.clip-busy: ProgressBar {
                label: root.clip-label;
                percent: root.clip-percent;
            }

            if root.mode == 4 && !root.content-search: Rectangle {
                height: 36px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: "Search by content: set \"semantic\": true / \"ocr\": true in ~/.config/luma/settings.json";
                        color: Theme.text-dim;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if root.mode == 1: AppsView {
                apps: root.apps;
                categories: root.categories;
                selected-category <=> root.selected-category;
                sel <=> root.sel;
                cols <=> root.cols;
                tip-sel <=> root.tip-sel;
                filter_category(category) => { root.filter_category(category); }
                launch-app(app) => { root.launch-app(app); }
                toggle-pin(app) => { root.toggle-pin(app); }
                hide-window => { root.hide-window(); }
                hover-tip(hover, idx, name, x, y, h) => { root.hover-tip(hover, idx, name, x, y, h); }
            }

            if root.mode == 2 || root.mode == 4: FilesView {
                files: root.files;
                input-text: root.input-text;
                files-sort <=> root.files-sort;
                sel <=> root.sel;
                cols <=> root.cols;
                tip-sel <=> root.tip-sel;
                show_files => { root.show_files(); }
                search_files(query) => { root.search_files(query); }
                open-file(file) => { root.open-file(file); }
                hide-window => { root.hide-window(); }
                hover-tip(hover, idx, name, x, y, h) => { root.hover-tip(hover, idx, name, x, y, h); }
            }

            if root.mode == 3: PowerView {
                power-opts: root.power-opts;
                sel <=> root.sel;
                power-action(action) => { root.power-action(action); }
            }

            // Settings view: empty for now
            if root.mode == 5: Text {
                text: "Settings";
                color: Theme.text-dim;
                font-size: 12px;
                height: 18px;
            }

            // Unified search from the main view: apps first, files below
            if root.mode == 0 && root.input-text != "": MixedView {
                apps: root.apps;
                files: root.files;
                sel <=> root.sel;
                tip-sel <=> root.tip-sel;
                launch-app(app) => { root.launch-app(app); }
                open-file(file) => { root.open-file(file); }
                hide-window => { root.hide-window(); }
                hover-tip(hover, idx, name, x, y, h) => { root.hover-tip(hover, idx, name, x, y, h); }
            }

            // Footer hint bar, Walker-style
            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    padding-left: 12px;
                    padding-right: 44px;

                    Text {
                        text: "Enter: launch | Alt+1: apps | Alt+2: files | Alt+3: photos | Alt+4: settings | Esc: close";
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    x: parent.width - self.width - 8px;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    border-radius: 5px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    Image {
                        source: @image-url("assets/power.svg");
                        colorize: Theme.text-dim;
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;

                        clicked => {
                            root.activate-mode(3);
                        }
                    }
                }
            }
            }

        }
    }

    // Drawn last at the root so the scroll views don't clip it: below the
    // hovered item, above it when there is no room, x kept inside the window.
    if root.tip-text != "" && root.tip-sel == root.sel: Rectangle {
        x: max(4px, min(root.width - self.width - 4px, root.tip-x));
        y: root.tip-y + root.tip-h + 4px + self.height > root.height - 4px
            ? root.tip-y - self.height - 4px
            : root.tip-y + root.tip-h + 4px;
        width: tip-label.width + 16px;
        height: tip-label.height + 8px;
        border-radius: 4px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        tip-label := Text {
            x: 8px;
            y: 4px;
            // names wider than the window wrap instead of spilling out
            width: min(self.preferred-width, root.width - 24px);
            height: self.preferred-height;
            text: root.tip-text;
            color: Theme.text;
            font-size: 12px;
            wrap: char-wrap;
        }
    }
}

export component LoadingWindow inherits Window {
    width: 240px;
    height: 52px;
    background: transparent;

    Rectangle {
        border-radius: 8px;
        background: #0E120B;
        border-width: 2px;
        border-color: #2C3620;

        Text {
            text: "Loading...";
            color: #E4E7D0;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}
