import { ScrollView } from "std-widgets.slint";

// Omarchy/Walker-ish restyle of the Spotlight layout.

export struct AppItem {
    name: string,
    path: string,
    command: string,
    icon: image,
}

export component MainWindow inherits Window {
    in property <[AppItem]> apps;
    in property <[string]> categories;
    in-out property <string> selected-category;
    callback show_apps();
    callback launch_app(AppItem);
    callback search_apps(query: string);
    callback filter_category(string);
    callback run_query(string);
    callback hide-window();

    public function focus-input() {
        search-input.focus();
    }
    public function reset-view() {
        root.apps-open = false;
        root.selected-category = "";
    }
    in-out property <string> query-result;
    in-out property <string> input-text;
    private property <bool> apps-open: false;

    // Palette (overridable from settings.json via main.rs)
    in property <color> bg: #0E120B;
    in property <color> surface: #151B10;
    in property <color> hover: #1E2716;
    in property <color> selected: #28331C;
    in property <color> border: #2C3620;
    in property <color> accent: #A9B665;
    in property <color> text: #E4E7D0;
    in property <color> text-dim: #7E8A6C;

    min-width: 760px;
    max-width: 760px;
    background: transparent;
    default-font-family: "JetBrainsMono Nerd Font";

    FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.hide-window(); }
        }

        KeyBinding {
            keys: @keys(Alt + "1");
            activated => {
                root.apps-open = !root.apps-open;
                if root.apps-open {
                    root.show_apps();
                    if root.input-text != "" {
                        root.search_apps(root.input-text);
                    }
                }
            }
        }

        // Single bordered panel instead of floating pills
        Rectangle {
            background: root.bg;
            border-width: 2px;
            border-color: root.border;
            border-radius: 10px;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

            HorizontalLayout {
                height: 52px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 52px;
                    border-radius: 8px;
                    background: root.surface;
                    border-width: 1px;
                    border-color: root.border;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        Image {
                            source: @image-url("assets/search.svg");
                            colorize: root.accent;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }

                        search-input := TextInput {
                            text <=> root.input-text;
                            font-size: 17px;
                            color: root.text;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if event.modifiers.alt && event.text == "1" {
                                    root.apps-open = !root.apps-open;
                                    if root.apps-open {
                                        root.show_apps();
                                        if root.input-text != "" {
                                            root.search_apps(root.input-text);
                                        }
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                            edited => {
                                if root.apps-open {
                                    root.search_apps(self.text);
                                }
                            }
                            accepted => {
                                if root.apps-open && root.apps.length > 0 {
                                    root.launch-app(root.apps[0]);
                                } else {
                                    root.run_query(self.text);
                                }
                            }
                        }

                        if root.input-text == "": Text {
                            text: "Search apps...";
                            color: root.text-dim;
                            font-size: 17px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 8px;
                    background: root.apps-open ? root.selected : root.surface;
                    border-width: 1px;
                    border-color: root.apps-open ? root.accent : root.border;

                    Image {
                        source: @image-url("assets/layout-grid.svg");
                        colorize: root.apps-open ? root.accent : root.text-dim;
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;

                        clicked => {
                            root.apps-open = !root.apps-open;

                            if root.apps-open {
                                root.show_apps();
                                if root.input-text != "" {
                                    root.search_apps(root.input-text);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 8px;
                    background: root.surface;
                    border-width: 1px;
                    border-color: root.border;

                    Image {
                        source: @image-url("assets/folder.svg");
                        colorize: root.text-dim;
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 8px;
                    background: root.surface;
                    border-width: 1px;
                    border-color: root.border;

                    Image {
                        source: @image-url("assets/zap.svg");
                        colorize: root.text-dim;
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 8px;
                    background: root.surface;
                    border-width: 1px;
                    border-color: root.border;

                    Image {
                        source: @image-url("assets/clipboard-pen.svg");
                        colorize: root.text-dim;
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            if root.query-result != "": Rectangle {
                height: 44px;
                background: root.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.border;

                Text {
                    text: root.query-result;
                    color: root.accent;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.apps-open: VerticalLayout {
                height: 350px;

                Flickable {
                    height: 40px;
                    content-width: pills-row.preferred-width;

                    pills-row := HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 2px;
                        padding-top: 4px;
                        spacing: 8px;
                        alignment: start;

                        for cat in root.categories: Rectangle {
                            height: 30px;
                            min-width: cat-text.preferred-width + 22px;
                            horizontal-stretch: 0;
                            border-radius: 6px;
                            background: root.selected-category == cat ? root.selected : root.surface;
                            border-width: 1px;
                            border-color: root.selected-category == cat ? root.accent : root.border;

                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;

                                cat-text := Text {
                                    text: cat;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    color: root.selected-category == cat ? root.accent : root.text-dim;
                                    overflow: elide;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    root.selected-category = root.selected-category == cat ? "" : cat;
                                    root.filter_category(root.selected-category);
                                }
                            }
                        }
                    }
                }

                ScrollView {
                    width: parent.width;
                    height: parent.height;

                    FlexboxLayout {
                        padding-top: 4px;
                        spacing: 10px;

                        flex-direction: row;
                        flex-wrap: wrap;

                        for app in root.apps: Rectangle {
                            width: 90px;
                            height: 92px;
                            border-radius: 8px;
                            background: app-touch.has-hover ? root.hover : transparent;
                            border-width: 1px;
                            border-color: app-touch.has-hover ? root.accent : transparent;

                            place := Rectangle {
                                width: 48px;
                                height: 48px;
                                x: (parent.width - self.width) / 2;
                                y: 8px;
                                border-radius: 8px;
                                background: root.surface;
                                border-width: 1px;
                                border-color: root.border;
                            }

                            Image {
                                source: app.icon;
                                colorize: root.text-dim;

                                x: place.x;
                                y: place.y;

                                width: 48px;
                                height: 48px;
                                image-fit: contain;
                            }

                            Text {
                                text: app.name;
                                x: 4px;
                                y: 62px;
                                width: parent.width - 8px;
                                height: 20px;
                                color: root.text;
                                font-size: 12px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            app-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;

                                clicked => {
                                    root.launch-app(app);
                                }
                            }
                        }
                    }
                }
            }

            // Footer hint bar, Walker-style
            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: root.surface;
                border-width: 1px;
                border-color: root.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: "Enter: launch  |  Alt+1: apps  |  Esc: close";
                        color: root.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: "Luma";
                        color: root.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
            }

        }
    }
}

export component LoadingWindow inherits Window {
    width: 240px;
    height: 52px;
    background: transparent;

    Rectangle {
        border-radius: 8px;
        background: #0E120B;
        border-width: 2px;
        border-color: #2C3620;

        Text {
            text: "Loading...";
            color: #E4E7D0;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}